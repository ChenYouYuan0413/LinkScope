LinkScope.app/Contents/PkgInfo: 
	@test -d LinkScope.app/Contents || mkdir -p LinkScope.app/Contents
	@$(DEL_FILE) LinkScope.app/Contents/PkgInfo
	@echo "APPL????" > LinkScope.app/Contents/PkgInfo
LinkScope.app/Contents/Resources/empty.lproj: 
	@test -d LinkScope.app/Contents/Resources || mkdir -p LinkScope.app/Contents/Resources
	@touch LinkScope.app/Contents/Resources/empty.lproj
	
LinkScope.app/Contents/Info.plist: 
	@test -d LinkScope.app/Contents || mkdir -p LinkScope.app/Contents
	@$(DEL_FILE) LinkScope.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.LinkScope,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.LinkScope,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,LinkScope,g" -e "s,@LIBRARY@,LinkScope,g" -e "s,\$${EXECUTABLE_NAME},LinkScope,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/homebrew/Cellar/qt@5/5.15.19/mkspecs/macx-clang/Info.plist.app >LinkScope.app/Contents/Info.plist


####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/LinkScope/bin || mkdir -p $(INSTALL_ROOT)/opt/LinkScope/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/LinkScope/bin/LinkScope.app
	
	$(QINSTALL) LinkScope.app $(INSTALL_ROOT)/opt/LinkScope/bin/LinkScope.app
	-$(STRIP) $(INSTALL_ROOT)/opt/LinkScope/bin/LinkScope.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/LinkScope/bin/LinkScope.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/LinkScope/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

